<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="4.0" DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <Configuration Condition=" '$(Configuration)' == '' ">Debug</Configuration>
    <SchemaVersion>2.0</SchemaVersion>
    <ProjectGuid>{5FAF095F-5A1E-4AB2-9F3B-6F02B6B4B8B6}</ProjectGuid>
    <ProjectHome>.</ProjectHome>
    <StartupFile>Src\gui.py</StartupFile>
    <SearchPath>Src</SearchPath>
    <WorkingDirectory>.</WorkingDirectory>
    <Name>Rush-Royale-Bot</Name>
    <RootNamespace>RushRoyaleBot</RootNamespace>
    <InterpreterId>MSBuild|env|$(ProjectDir)\.bot_env</InterpreterId>
    <InterpreterPath>$(ProjectDir)\.bot_env\Scripts\python.exe</InterpreterPath>
    <InterpreterArguments></InterpreterArguments>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Src\**\*.py" />
    <Compile Include="scripts\**\*.py" />
    <Compile Include="*.py" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="README.md" />
    <Content Include="requirements.txt" />
    <Content Include="config.ini" />
    <Content Include="install.bat" />
    <Content Include="launch_gui.bat" />
    <Content Include="scripts\launch_modern_gui.bat" />
    <Content Include="RR_bot.ipynb" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Src" />
    <Folder Include="scripts" />
    <Folder Include="cv-images" />
  </ItemGroup>

  <Import Project="$(MSBuildExtensionsPath32)\Microsoft\VisualStudio\v$(VisualStudioVersion)\Python Tools\Microsoft.PythonTools.targets" />
</Project>
