# ----------------------------------------------------------------------------
# Machine Learning & Training Data
# ----------------------------------------------------------------------------
# User-generated training data (too large for git, but keep directory structure)
training_data/screenshots/*
!training_data/screenshots/.gitkeep
training_data/units/
machine_learning/inputs/*
!machine_learning/inputs/.gitkeep
machine_learning/raw_input/*
!machine_learning/raw_input/.gitkeep
machine_learning/unit_inputs/**/*
!machine_learning/unit_inputs/.gitkeep
OCR_inputs/*
!OCR_inputs/.gitkeep

# Generated ML models (models/*.pkl are tracked in git!)
# Note: Pre-trained models in models/ directory are versioned
*.h5
*.hdf5
*.pb
*.onnx
*.pt
*.pth
*.joblib

# ML experiment tracking
mlruns/
.mlflow/
wandb/
tensorboard/
runs/

# Data files
*.csv
*.tsv
*.dat
*.data
*.parquet
*.feather

