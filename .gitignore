# ----------------------------------------------------------------------------
# Keep Important Files (Force Include)
# ----------------------------------------------------------------------------
# These patterns override previous ignores
!.env.example
!.gitkeep
!README.md
!LICENSE
!CHANGELOG.md
!Commits.md

# Keep CI/CD workflows
!.github/
!.github/**

# Keep template images (organized structure)
!cv-images/
!cv-images/**/*.png
!cv-images/**/*.jpg

# Keep example/demo files
!examples/
!examples/**

